---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Badge from '../components/Badge.astro';
import siteConfig from '../site.config';
import { getCollection } from 'astro:content';
import { url } from '../utils/paths';

// Fetch non-draft posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const latestRants = sortedPosts.filter((p) => p.data.type === 'rant').slice(0, 3);
const latestBuilds = sortedPosts.filter((p) => p.data.type === 'build').slice(0, 3);

// Fetch featured project
const allProjects = await getCollection('projects');
const featuredProject = allProjects.find((p) => p.data.featured) || allProjects[0];
---

<BaseLayout title={`${siteConfig.name} — Personal Tech Blog & Engineering Notes`}>
  <!-- Hero / Intro -->
  <section class="py-8 sm:py-12 border-b border-zinc-200 dark:border-zinc-800">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 font-mono text-xs text-zinc-600 dark:text-zinc-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>BCIT @ NED University, Karachi</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-zinc-900 dark:text-zinc-100 mb-4 leading-tight">
        {siteConfig.author}
      </h1>

      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 font-normal leading-relaxed mb-6">
        Building software fast, learning AI engineering, and documenting the journey.
        Here you'll find two things: <strong class="text-rose-600 dark:text-rose-400 font-semibold">opinionated rants</strong> about tools that test my patience, and <strong class="text-sky-600 dark:text-sky-400 font-semibold">detailed builds</strong> breaking down real code, bugs, and architectures.
      </p>

      <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
        <a
          href={url('/blog')}
          class="px-4 py-2 rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium hover:bg-zinc-800 dark:hover:bg-white transition-colors"
        >
          Read the Blog &rarr;
        </a>
        <a
          href={url('/projects')}
          class="px-4 py-2 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors"
        >
          View Projects
        </a>
        <a
          href={url('/about')}
          class="px-4 py-2 text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        >
          About Me
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Project Strip -->
  {featuredProject && (
    <section class="my-10 p-6 rounded-2xl border border-teal-500/30 bg-teal-500/5 dark:bg-teal-950/20 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase font-semibold text-teal-600 dark:text-teal-400 tracking-wider">
              ★ Featured Project
            </span>
            <Badge type={featuredProject.data.status} />
          </div>
          <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
            {featuredProject.data.title}
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl">
            {featuredProject.data.summary}
          </p>
          <div class="flex flex-wrap gap-1.5 pt-1 font-mono text-xs text-zinc-500">
            {featuredProject.data.stack.map((tech) => (
              <span class="px-2 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800/80 border border-zinc-300/50 dark:border-zinc-700/50">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <div class="flex sm:flex-col items-center gap-2 shrink-0 w-full sm:w-auto">
          {featuredProject.data.liveUrl && (
            <a
              href={featuredProject.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center px-4 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-mono text-xs transition-colors"
            >
              Visit Live &nearr;
            </a>
          )}
          <a
            href={url('/projects')}
            class="w-full text-center px-4 py-2 rounded-lg border border-zinc-300 dark:border-zinc-700 font-mono text-xs text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors"
          >
            All Projects &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Two Columns: Latest Rants vs Latest Builds -->
  <section class="my-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- Column 1: Latest Rants -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500"></span>
            <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              Latest Rants
            </h2>
          </div>
          <a
            href={url('/blog?type=rant')}
            class="font-mono text-xs text-rose-600 dark:text-rose-400 hover:underline"
          >
            View all rants &rarr;
          </a>
        </div>

        <div class="flex flex-col gap-4">
          {latestRants.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </div>

      <!-- Column 2: Latest Builds -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-sky-500"></span>
            <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              Latest Builds
            </h2>
          </div>
          <a
            href={url('/blog?type=build')}
            class="font-mono text-xs text-sky-600 dark:text-sky-400 hover:underline"
          >
            View all builds &rarr;
          </a>
        </div>

        <div class="flex flex-col gap-4">
          {latestBuilds.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
