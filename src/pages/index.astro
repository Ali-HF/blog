---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Badge from '../components/Badge.astro';
import siteConfig from '../site.config';
import { getCollection } from 'astro:content';
import { url } from '../utils/paths';

// Fetch non-draft posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const latestRants = sortedPosts.filter((p) => p.data.type === 'rant').slice(0, 3);
const latestBuilds = sortedPosts.filter((p) => p.data.type === 'build').slice(0, 3);

// Fetch featured project
const allProjects = await getCollection('projects');
const featuredProject = allProjects.find((p) => p.data.featured) || allProjects[0];
const totalArticles = sortedPosts.length;
---

<BaseLayout title={`${siteConfig.name} — Main Page`}>
  <!-- Wikipedia Main Page Welcome Banner -->
  <section class="border border-[var(--border-color)] bg-[var(--bg-surface)] p-4 sm:p-6 mb-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[var(--border-color)] pb-4 mb-4">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-normal text-[var(--text-primary)]">
          Welcome to <span class="font-bold">{siteConfig.name}</span>,
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-serif italic mt-0.5">
          the personal encyclopedia of developer rants, shipped software, and technical post-mortems.
        </p>
      </div>

      <div class="text-xs font-mono text-right text-[var(--text-secondary)] shrink-0 space-y-0.5">
        <div>Total articles: <strong class="text-[var(--text-primary)]">{totalArticles}</strong></div>
        <div>Curator: <strong class="text-[var(--text-primary)]">{siteConfig.author}</strong> (NED University)</div>
      </div>
    </div>

    <!-- Wikipedia Portal Nav Strip -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-serif">
      <div class="flex flex-wrap items-center gap-4">
        <span>Portals:</span>
        <a href={url('/blog?type=rant')} class="underline hover:text-black dark:hover:text-white">Rants &amp; Opinions</a>
        <span>•</span>
        <a href={url('/blog?type=build')} class="underline hover:text-black dark:hover:text-white">Fullstack Builds</a>
        <span>•</span>
        <a href={url('/projects')} class="underline hover:text-black dark:hover:text-white">Project Index</a>
        <span>•</span>
        <a href={url('/about')} class="underline hover:text-black dark:hover:text-white">Biography</a>
      </div>

      <div class="font-mono text-[11px] text-[var(--text-muted)]">
        Free to read • Zero telemetry
      </div>
    </div>
  </section>

  <!-- Wikipedia Featured Article Box (Featured Project) -->
  {featuredProject && (
    <section class="border border-[var(--border-color)] bg-[var(--bg-card)] mb-8">
      <div class="bg-[var(--border-light)] px-4 py-2 border-b border-[var(--border-color)] flex items-center justify-between font-serif">
        <h2 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span>★</span>
          <span>Today's featured project</span>
        </h2>
        <span class="font-mono text-xs text-[var(--text-secondary)]">Year: {featuredProject.data.year}</span>
      </div>

      <div class="p-4 sm:p-6 flex flex-col md:flex-row gap-6">
        <div class="flex-1 space-y-3">
          <div class="flex items-center gap-2">
            <h3 class="font-serif text-xl font-bold text-[var(--text-primary)]">
              {featuredProject.data.title}
            </h3>
            <Badge type={featuredProject.data.status} />
          </div>

          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            {featuredProject.data.summary}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-2 text-xs font-mono">
            <span class="font-bold text-[var(--text-primary)]">Specification stack:</span>
            {featuredProject.data.stack.map((t) => (
              <span class="border border-[var(--border-color)] px-1.5 py-0.5 bg-[var(--bg-surface)]">
                {t}
              </span>
            ))}
          </div>
        </div>

        <!-- Mini Wiki Infobox for Featured Item -->
        <div class="w-full md:w-60 border border-[var(--border-color)] bg-[var(--bg-surface)] p-3 text-xs font-mono space-y-2 shrink-0">
          <div class="text-center font-serif font-bold pb-1 border-b border-[var(--border-subtle)]">
            Quick Reference
          </div>
          <div class="flex justify-between border-b border-[var(--border-subtle)] pb-1">
            <span class="text-[var(--text-muted)]">Status:</span>
            <span>{featuredProject.data.status}</span>
          </div>
          <div class="flex justify-between border-b border-[var(--border-subtle)] pb-1">
            <span class="text-[var(--text-muted)]">Category:</span>
            <span>Software</span>
          </div>
          {featuredProject.data.liveUrl && (
            <div class="pt-1 text-center">
              <a
                href={featuredProject.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-1 text-center border border-[var(--border-color)] bg-[var(--bg-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] transition-colors"
              >
                External Link &nearr;
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Two Columns (Wikipedia Style Side-by-Side Panels) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Left Column: Did you know... (Latest Rants) -->
    <section class="border border-[var(--border-color)] bg-[var(--bg-card)]">
      <div class="bg-[var(--border-light)] px-4 py-2 border-b border-[var(--border-color)] flex items-center justify-between font-serif">
        <h2 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span>■</span>
          <span>From the editorial rants</span>
        </h2>
        <a href={url('/blog?type=rant')} class="text-xs font-mono underline hover:text-[var(--text-primary)]">
          All rants &rarr;
        </a>
      </div>

      <div class="p-4 divide-y divide-[var(--border-light)] space-y-4">
        {latestRants.map((post) => (
          <div class="pt-3 first:pt-0">
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>

    <!-- Right Column: Recent engineering write-ups (Latest Builds) -->
    <section class="border border-[var(--border-color)] bg-[var(--bg-card)]">
      <div class="bg-[var(--border-light)] px-4 py-2 border-b border-[var(--border-color)] flex items-center justify-between font-serif">
        <h2 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span>□</span>
          <span>Recent engineering builds</span>
        </h2>
        <a href={url('/blog?type=build')} class="text-xs font-mono underline hover:text-[var(--text-primary)]">
          All builds &rarr;
        </a>
      </div>

      <div class="p-4 divide-y divide-[var(--border-light)] space-y-4">
        {latestBuilds.map((post) => (
          <div class="pt-3 first:pt-0">
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
