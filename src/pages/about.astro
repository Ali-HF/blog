---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../site.config';

const actionsUrl = `https://github.com/${siteConfig.githubUser}/${siteConfig.repoName}/actions`;
---

<BaseLayout
  title="Ali Hasan"
  description="Biographical encyclopedia article for Ali Hasan (Ali-HF), BCIT student at NED University, Karachi."
>
  <div class="max-w-4xl mx-auto">
    <!-- Header with Wikipedia title -->
    <header class="pb-2 mb-6 border-b border-[var(--border-color)]">
      <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal">
        Ali Hasan
      </h1>
      <p class="text-xs font-serif italic text-[var(--text-secondary)] mt-1">
        From Ali's Wiki, the free encyclopedia of dev logs and engineering builds.
      </p>
    </header>

    <!-- Wikipedia Biography Infobox -->
    <aside class="wiki-infobox float-none sm:float-right mb-6 sm:ml-6 sm:mb-4 border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs">
      <div class="bg-[var(--border-light)] p-2 text-center font-serif font-bold text-[var(--text-primary)] border-b border-[var(--border-color)]">
        Ali Hasan
      </div>

      <!-- Monochrome Portrait Glyph Box -->
      <div class="p-4 border-b border-[var(--border-subtle)] bg-[var(--bg-card)] flex flex-col items-center justify-center">
        <div class="w-20 h-20 border border-[var(--border-color)] flex items-center justify-center font-serif font-black text-3xl select-none bg-[var(--bg-surface)]">
          AH
        </div>
        <div class="text-[10px] font-mono text-[var(--text-muted)] mt-2">Ali-HF (GitHub)</div>
      </div>

      <table class="w-full border-collapse">
        <tbody>
          <tr>
            <th class="w-1/3 text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Location</th>
            <td class="border-b border-[var(--border-subtle)] p-2">Karachi, Pakistan</td>
          </tr>
          <tr>
            <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Alma mater</th>
            <td class="border-b border-[var(--border-subtle)] p-2">
              <a href="https://www.neduet.edu.pk" target="_blank" rel="noopener noreferrer" class="underline">
                NED University
              </a> (BCIT)
            </td>
          </tr>
          <tr>
            <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Occupation</th>
            <td class="border-b border-[var(--border-subtle)] p-2">Student, AI Engineer in training</td>
          </tr>
          <tr>
            <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Ventures</th>
            <td class="border-b border-[var(--border-subtle)] p-2">
              <a href={siteConfig.notebloomUrl} target="_blank" rel="noopener noreferrer" class="underline">Notebloom</a>,{' '}
              <a href={siteConfig.hkhAgencyUrl} target="_blank" rel="noopener noreferrer" class="underline">hkh.agency</a>
            </td>
          </tr>
          <tr>
            <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Core Focus</th>
            <td class="border-b border-[var(--border-subtle)] p-2 font-mono text-[11px]">C++, DSA, MERN, AI</td>
          </tr>
          <tr>
            <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Website</th>
            <td class="border-b border-[var(--border-subtle)] p-2 font-mono text-[11px]">
              <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="underline">
                github.com/{siteConfig.githubUser}
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </aside>

    <!-- Article Lead -->
    <div class="prose-custom font-serif text-[15px] leading-relaxed text-[var(--text-primary)]">
      <p class="first-letter:text-2xl first-letter:font-bold">
        <strong>Ali Hasan</strong> (known online as <strong>Ali-HF</strong>) is a Pakistani computer science student and software builder currently pursuing a Bachelor of Science in Computer Science and Information Technology (BCIT) at NED University of Engineering and Technology in Karachi.
      </p>

      <h2>1. Academic Background and Interests</h2>
      <p>
        Hasan's technical coursework centers on computer science fundamentals, including Object-Oriented Programming (CT-260) in C++, Data Structures and Algorithms (CS-214), and Professional Ethics (CT-268). His academic projects prioritize spatial 3D algorithms visualizers, local RAG retrieval assistants, and systems-level compiler linking on Windows.
      </p>

      <h2>2. Ventures and Industry Work</h2>
      <p>
        In parallel with his undergraduate studies, Hasan established two commercial and digital ventures:
      </p>
      <ul>
        <li>
          <strong>Notebloom</strong>: An e-commerce stationery brand and custom software platform engineered using Next.js 16, Supabase, and Tailwind CSS v4, combining digital web store operations with retail stall presence at Habitt.
        </li>
        <li>
          <strong>hkh.agency</strong>: A digital marketing agency providing development and growth infrastructure for businesses.
        </li>
      </ul>

      <h2>3. Philosophy on AI Tooling</h2>
      <p>
        Hasan advocates for high-speed software development leveraging modern AI engineering assistants—such as Antigravity, Groq, FastEmbed, and Claude—paired with candid transparency regarding their usage. He emphasizes that rapid generative scaffolding must be grounded in an understanding of memory allocation, SQL transaction locks, and cryptographic handshakes.
      </p>

      <!-- ALI opinion comment hook -->
      <!-- ALI: add your personal philosophy on balancing university life, coding projects, and running businesses -->

      <h2>4. Version Control and Continuous Deployment</h2>
      <p>
        This encyclopedia is compiled statically with Astro and deployed continuously to GitHub Pages using GitHub Actions upon every verified push to the repository trunk.
      </p>

      <div class="p-3 my-4 border border-[var(--border-color)] bg-[var(--bg-surface)] font-mono text-xs space-y-1">
        <div><strong>Repository:</strong> <a href={`https://github.com/${siteConfig.githubUser}/${siteConfig.repoName}`} class="underline" target="_blank" rel="noopener noreferrer">{siteConfig.githubUser}/{siteConfig.repoName}</a></div>
        <div><strong>Deployment Pipeline:</strong> <a href={actionsUrl} class="underline" target="_blank" rel="noopener noreferrer">{actionsUrl} &nearr;</a></div>
      </div>

      <h2>5. External Links</h2>
      <ul class="font-mono text-xs space-y-1">
        <li>• <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="underline">Official GitHub Profile (Ali-HF)</a></li>
        <li>• <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="underline">LinkedIn Profile Placeholder</a></li>
        <li>• <a href={siteConfig.notebloomUrl} target="_blank" rel="noopener noreferrer" class="underline">Notebloom Official Website</a></li>
        <li>• <a href={siteConfig.hkhAgencyUrl} target="_blank" rel="noopener noreferrer" class="underline">hkh.agency Official Website</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
