---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/paths';
---

<BaseLayout
  title="Wikipedia: Article not found (404)"
  description="This encyclopedia article does not exist."
>
  <div class="max-w-2xl mx-auto py-10 space-y-6">
    <header class="pb-2 border-b border-[var(--border-color)]">
      <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal">
        Error 404: Article Not Found
      </h1>
      <p class="text-xs font-serif italic text-[var(--text-secondary)] mt-1">
        Ali's Wiki does not have an encyclopedia article with this exact name.
      </p>
    </header>

    <div class="p-4 border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono space-y-2">
      <div><strong>Status:</strong> HTTP 404 Null Dereference</div>
      <div><strong>Diagnostics:</strong> The requested slug does not match any entry in the static pages index.</div>
    </div>

    <div class="prose-custom font-serif text-[15px] space-y-3">
      <p>
        The page you requested may have been moved, renamed, or never existed in the first place. You can try searching the index or returning to the portal main page.
      </p>
    </div>

    <div class="pt-4 flex items-center gap-4 text-xs font-mono">
      <a
        href={url('/')}
        class="px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] transition-colors"
      >
        &larr; Return to Main Page
      </a>
      <a
        href={url('/blog')}
        class="px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] transition-colors"
      >
        Search Article Archive
      </a>
    </div>
  </div>
</BaseLayout>
