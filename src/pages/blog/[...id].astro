---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { url } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sorted.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] || null, // older post
      nextPost: sorted[index - 1] || null, // newer post
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, type, tags, status, stack, repo, liveUrl } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdate = updatedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(updatedDate)
  : null;

const readingTime = getReadingTime(post.body || '');
const showToc = headings.length >= 3;
---

<BaseLayout
  title={title}
  description={description}
  articleDate={pubDate}
  articleType={type}
>
  <div class="max-w-3xl mx-auto">
    <!-- Back button -->
    <a
      href={url('/blog')}
      class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 hover:text-teal-600 dark:hover:text-teal-400 transition-colors mb-8 group"
    >
      <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
      <span>Back to all posts</span>
    </a>

    <!-- Post Header -->
    <header class="pb-8 border-b border-zinc-200 dark:border-zinc-800 space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <Badge type={type} size="md" />
        {status && <Badge type={status} size="md" />}
        <span class="font-mono text-xs text-zinc-400">•</span>
        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{readingTime}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-zinc-900 dark:text-zinc-100 tracking-tight leading-tight">
        {title}
      </h1>

      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500 pt-2">
        <div>
          <span>Published on </span>
          <time datetime={pubDate.toISOString()} class="text-zinc-700 dark:text-zinc-300 font-medium">
            {formattedDate}
          </time>
        </div>
        {formattedUpdate && (
          <div>
            <span>(Updated: </span>
            <time datetime={updatedDate?.toISOString()}>{formattedUpdate}</time>
            <span>)</span>
          </div>
        )}
      </div>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-2">
          {tags.map((tag) => (
            <a
              href={url(`/tags/${tag}`)}
              class="font-mono text-xs px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Build Facts Box (For Builds only) -->
    {type === 'build' && (
      <aside class="my-8 p-5 rounded-xl border border-sky-500/30 bg-sky-500/5 dark:bg-sky-950/20 space-y-3 font-mono text-xs">
        <div class="flex items-center justify-between pb-2 border-b border-sky-500/20">
          <span class="font-bold uppercase tracking-wider text-sky-700 dark:text-sky-300 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Build Facts &amp; Specifications
          </span>
          {status && <Badge type={status} />}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          {stack && stack.length > 0 && (
            <div class="sm:col-span-2">
              <span class="text-zinc-400 block mb-1">Architecture &amp; Tech Stack:</span>
              <div class="flex flex-wrap gap-1.5">
                {stack.map((t) => (
                  <span class="px-2 py-0.5 rounded bg-white dark:bg-zinc-900 border border-sky-500/30 text-sky-900 dark:text-sky-200">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          )}

          {repo && (
            <div>
              <span class="text-zinc-400 block mb-1">Repository:</span>
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-teal-600 dark:text-teal-400 hover:underline break-all inline-flex items-center gap-1"
              >
                {repo.replace('https://github.com/', '')} &nearr;
              </a>
            </div>
          )}

          {liveUrl && (
            <div>
              <span class="text-zinc-400 block mb-1">Live Deployment:</span>
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-teal-600 dark:text-teal-400 hover:underline break-all inline-flex items-center gap-1"
              >
                {liveUrl} &nearr;
              </a>
            </div>
          )}
        </div>
      </aside>
    )}

    <!-- Table of Contents for Long Posts -->
    {showToc && (
      <details class="my-8 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 text-xs font-mono">
        <summary class="cursor-pointer font-semibold text-zinc-700 dark:text-zinc-300 select-none">
          Table of Contents ({headings.length} sections)
        </summary>
        <nav class="mt-3 space-y-1.5 pl-2 border-l border-zinc-200 dark:border-zinc-700">
          {headings.map((h) => (
            <a
              href={`#${h.slug}`}
              class={`block text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors ${
                h.depth === 3 ? 'pl-4' : ''
              }`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </details>
    )}

    <!-- Markdown Article Content (Indexed by Pagefind) -->
    <article data-pagefind-body class="prose-custom py-6">
      <Content />
    </article>

    <!-- Post Navigation (Prev / Next) -->
    <nav class="my-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
      {prevPost ? (
        <a
          href={url(`/blog/${prevPost.id}`)}
          class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors flex flex-col gap-1 group"
        >
          <span class="text-zinc-400 group-hover:text-teal-500 transition-colors">&larr; Older post</span>
          <span class="font-bold text-zinc-900 dark:text-zinc-100 line-clamp-1">{prevPost.data.title}</span>
        </a>
      ) : (
        <div></div>
      )}

      {nextPost && (
        <a
          href={url(`/blog/${nextPost.id}`)}
          class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors flex flex-col gap-1 text-right group sm:ml-auto w-full"
        >
          <span class="text-zinc-400 group-hover:text-teal-500 transition-colors">Newer post &rarr;</span>
          <span class="font-bold text-zinc-900 dark:text-zinc-100 line-clamp-1">{nextPost.data.title}</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>
