---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { url } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sorted.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sorted[index + 1] || null, // older post
      nextPost: sorted[index - 1] || null, // newer post
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, type, tags, status, stack, repo, liveUrl } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdate = updatedDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(updatedDate)
  : null;

const readingTime = getReadingTime(post.body || '');
const showToc = headings.length >= 2;
---

<BaseLayout
  title={title}
  description={description}
  articleDate={pubDate}
  articleType={type}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb / Wiki navigation -->
    <div class="flex items-center justify-between text-xs font-mono text-[var(--text-secondary)] pb-2 mb-4 border-b border-[var(--border-light)]">
      <div class="flex items-center gap-2">
        <a href={url('/blog')} class="hover:underline">&larr; Back to Archive</a>
        <span>/</span>
        <span class="capitalize">{type}s</span>
      </div>
      <div>
        <span>{readingTime}</span>
      </div>
    </div>

    <!-- Wikipedia Article Header -->
    <header class="pb-3 mb-6 border-b border-[var(--border-color)]">
      <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal tracking-tight">
        {title}
      </h1>
      <p class="text-xs font-serif italic text-[var(--text-secondary)] mt-1">
        From Ali's Wiki, the personal encyclopedia of engineering notes and software rants.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-[var(--text-muted)] pt-2">
        <span>Published: {formattedDate}</span>
        {formattedUpdate && <span>(Last revision: {formattedUpdate})</span>}
      </div>
    </header>

    <!-- Wikipedia Classic Infobox for Builds -->
    {type === 'build' && (
      <aside class="wiki-infobox float-none sm:float-right mb-6 sm:ml-6 sm:mb-4 border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs">
        <div class="bg-[var(--border-light)] p-2 text-center font-serif font-bold text-[var(--text-primary)] border-b border-[var(--border-color)]">
          {title}
        </div>
        <table class="w-full border-collapse">
          <tbody>
            <tr>
              <th class="w-1/3 text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Article Type</th>
              <td class="border-b border-[var(--border-subtle)] p-2 font-mono uppercase">
                <Badge type={type} />
              </td>
            </tr>
            {status && (
              <tr>
                <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Project Status</th>
                <td class="border-b border-[var(--border-subtle)] p-2 font-mono">
                  <Badge type={status} />
                </td>
              </tr>
            )}
            {stack && stack.length > 0 && (
              <tr>
                <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold align-top">Technology Stack</th>
                <td class="border-b border-[var(--border-subtle)] p-2 font-mono">
                  <ul class="list-none space-y-0.5">
                    {stack.map((t) => (
                      <li>• {t}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            )}
            {repo && (
              <tr>
                <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Source Code</th>
                <td class="border-b border-[var(--border-subtle)] p-2 font-mono break-all">
                  <a href={repo} target="_blank" rel="noopener noreferrer" class="underline hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black">
                    GitHub &nearr;
                  </a>
                </td>
              </tr>
            )}
            {liveUrl && (
              <tr>
                <th class="text-[var(--text-secondary)] border-b border-[var(--border-subtle)] p-2 text-left font-semibold">Deployment</th>
                <td class="border-b border-[var(--border-subtle)] p-2 font-mono break-all">
                  <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="underline hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black">
                    Live Site &nearr;
                  </a>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </aside>
    )}

    <!-- Lead Paragraph / Description -->
    <div class="font-serif text-base text-[var(--text-primary)] leading-relaxed mb-6 font-normal">
      <p class="first-letter:text-3xl first-letter:font-bold first-letter:mr-0.5">
        {description}
      </p>
    </div>

    <!-- Wikipedia Table of Contents Box -->
    {showToc && (
      <nav class="wiki-toc mb-6" aria-label="Contents">
        <div class="font-serif font-bold text-xs pb-1 mb-2 border-b border-[var(--border-subtle)] flex items-center justify-between gap-4">
          <span>Contents</span>
          <span class="font-mono text-[10px] text-[var(--text-muted)]">[numbered]</span>
        </div>
        <ol class="space-y-1 text-xs font-serif">
          {headings.map((h, i) => (
            <li class={`leading-tight ${h.depth === 3 ? 'pl-4 text-[11px]' : ''}`}>
              <span class="font-mono text-[var(--text-muted)] mr-1">{i + 1}</span>
              <a href={`#${h.slug}`} class="underline hover:text-black dark:hover:text-white">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Article Content -->
    <article data-pagefind-body class="prose-custom clear-left py-2">
      <Content />
    </article>

    <!-- Wikipedia Categories Box -->
    {tags && tags.length > 0 && (
      <div class="mt-8 p-3 border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono">
        <span class="font-bold text-[var(--text-primary)] mr-2">Categories:</span>
        {tags.map((tag, i) => (
          <span>
            <a href={url(`/tags/${tag}`)} class="underline hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black px-0.5">
              {tag}
            </a>
            {i < tags.length - 1 ? ' | ' : ''}
          </span>
        ))}
      </div>
    )}

    <!-- See Also / Navigation -->
    <div class="mt-8 pt-4 border-t border-[var(--border-color)] flex flex-col sm:flex-row justify-between gap-4 text-xs font-mono">
      {prevPost ? (
        <a href={url(`/blog/${prevPost.id}`)} class="hover:underline flex items-center gap-1">
          <span>&larr; Previous entry:</span>
          <span class="font-bold font-serif">{prevPost.data.title}</span>
        </a>
      ) : <div></div>}

      {nextPost && (
        <a href={url(`/blog/${nextPost.id}`)} class="hover:underline flex items-center gap-1 text-right sm:ml-auto">
          <span>Next entry:</span>
          <span class="font-bold font-serif">{nextPost.data.title}</span>
          <span>&rarr;</span>
        </a>
      )}
    </div>
  </div>
</BaseLayout>
