---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';
import { url } from '../../utils/paths';

// Fetch all non-draft posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Collect all unique tags with count
const tagCounts: Record<string, number> = {};
sortedPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const totalCount = sortedPosts.length;
const rantCount = sortedPosts.filter((p) => p.data.type === 'rant').length;
const buildCount = sortedPosts.filter((p) => p.data.type === 'build').length;
---

<BaseLayout
  title="Article Index"
  description="Chronological encyclopedia index of engineering write-ups and editorial rants by Ali Hasan."
>
  <div class="space-y-6">
    <!-- Header -->
    <header class="pb-2 border-b border-[var(--border-color)]">
      <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal">
        Article Index
      </h1>
      <p class="text-xs font-serif italic text-[var(--text-secondary)] mt-1">
        Showing all {totalCount} encyclopedia articles in reverse chronological order.
      </p>
    </header>

    <!-- Wikipedia Filter & Search Strip -->
    <div class="border border-[var(--border-color)] bg-[var(--bg-surface)] p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono">
      <!-- Tabs -->
      <div id="filter-tabs" class="flex items-center gap-1 border-b sm:border-b-0 border-[var(--border-subtle)] pb-2 sm:pb-0">
        <span class="text-[var(--text-muted)] mr-2">Filter:</span>
        <button
          type="button"
          data-type="all"
          class="filter-tab px-2.5 py-1 border border-[var(--border-color)] bg-[var(--bg-primary)] font-bold text-[var(--text-primary)]"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          data-type="rant"
          class="filter-tab px-2.5 py-1 border border-transparent hover:border-[var(--border-subtle)] text-[var(--text-secondary)]"
        >
          Rants ({rantCount})
        </button>
        <button
          type="button"
          data-type="build"
          class="filter-tab px-2.5 py-1 border border-transparent hover:border-[var(--border-subtle)] text-[var(--text-secondary)]"
        >
          Builds ({buildCount})
        </button>
      </div>

      <!-- Quick Filter Search Input -->
      <div class="relative w-full sm:w-64">
        <input
          id="post-quick-filter"
          type="text"
          placeholder="Filter by title..."
          class="w-full px-2.5 py-1 bg-[var(--bg-primary)] border border-[var(--border-color)] text-xs font-mono text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
        />
      </div>
    </div>

    <!-- Category Portal Cloud -->
    <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-3 text-xs font-mono">
      <span class="font-bold text-[var(--text-primary)] mr-2">All Categories:</span>
      <div class="inline-flex flex-wrap gap-x-2 gap-y-1">
        {tags.map(([tag, count]) => (
          <span>
            <a href={url(`/tags/${tag}`)} class="underline hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black">
              {tag}
            </a>
            <span class="text-[var(--text-muted)]">({count})</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
      {sortedPosts.map((post) => (
        <div class="post-item" data-type={post.data.type} data-title={post.data.title.toLowerCase()}>
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-posts-message" class="hidden text-center py-12 border border-dashed border-[var(--border-color)]">
      <p class="font-serif italic text-sm text-[var(--text-secondary)]">No articles match your selected filter.</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupBlogFilters() {
    const params = new URLSearchParams(window.location.search);
    const initialType = params.get('type') || 'all';

    const tabs = document.querySelectorAll('.filter-tab');
    const posts = document.querySelectorAll('.post-item');
    const input = document.getElementById('post-quick-filter');
    const emptyMsg = document.getElementById('no-posts-message');

    function applyFilter(selectedType, searchQuery = '') {
      let visibleCount = 0;
      tabs.forEach((tab) => {
        const type = tab.getAttribute('data-type');
        if (type === selectedType) {
          tab.classList.add('bg-[var(--bg-primary)]', 'font-bold', 'text-[var(--text-primary)]', 'border-[var(--border-color)]');
          tab.classList.remove('border-transparent', 'text-[var(--text-secondary)]');
        } else {
          tab.classList.remove('bg-[var(--bg-primary)]', 'font-bold', 'text-[var(--text-primary)]', 'border-[var(--border-color)]');
          tab.classList.add('border-transparent', 'text-[var(--text-secondary)]');
        }
      });

      posts.forEach((item) => {
        const itemType = item.getAttribute('data-type');
        const itemTitle = item.getAttribute('data-title') || '';
        const matchesType = selectedType === 'all' || itemType === selectedType;
        const matchesSearch = !searchQuery || itemTitle.includes(searchQuery.toLowerCase());

        if (matchesType && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const type = tab.getAttribute('data-type') || 'all';
        const newUrl = type === 'all' ? window.location.pathname : `?type=${type}`;
        window.history.replaceState({}, '', newUrl);
        applyFilter(type, input ? input.value : '');
      });
    });

    if (input) {
      input.addEventListener('input', () => {
        const currentType = new URLSearchParams(window.location.search).get('type') || 'all';
        applyFilter(currentType, input.value);
      });
    }

    applyFilter(initialType);
  }

  setupBlogFilters();
  document.addEventListener('astro:after-swap', setupBlogFilters);
</script>
