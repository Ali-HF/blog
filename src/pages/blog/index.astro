---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';
import { url } from '../../utils/paths';

// Fetch all non-draft posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Collect all unique tags with count
const tagCounts: Record<string, number> = {};
sortedPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const totalCount = sortedPosts.length;
const rantCount = sortedPosts.filter((p) => p.data.type === 'rant').length;
const buildCount = sortedPosts.filter((p) => p.data.type === 'build').length;
---

<BaseLayout
  title="Blog Archive"
  description="All opinionated rants and technical build write-ups by Ali Hasan, sorted newest first."
>
  <div class="space-y-8">
    <!-- Header -->
    <div class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">
        The Archive
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base max-w-2xl">
        Every technical project breakdown, bug autopsy, and unfiltered opinion on dev life.
      </p>
    </div>

    <!-- Filter Bar: Works without JS via URL parameters or with instant tab filtering -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <!-- Type Filter Tabs -->
      <div id="filter-tabs" class="inline-flex items-center p-1 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-xs">
        <a
          href={url('/blog')}
          data-type="all"
          class="filter-tab px-3 py-1.5 rounded-lg transition-colors text-zinc-900 dark:text-zinc-100 font-medium bg-white dark:bg-zinc-800 shadow-xs"
        >
          All ({totalCount})
        </a>
        <a
          href={url('/blog?type=rant')}
          data-type="rant"
          class="filter-tab px-3 py-1.5 rounded-lg transition-colors text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
        >
          Rants ({rantCount})
        </a>
        <a
          href={url('/blog?type=build')}
          data-type="build"
          class="filter-tab px-3 py-1.5 rounded-lg transition-colors text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
        >
          Builds ({buildCount})
        </a>
      </div>

      <!-- Quick Search input fallback -->
      <div class="relative w-full sm:w-64">
        <input
          id="post-quick-filter"
          type="text"
          placeholder="Filter by title..."
          class="w-full px-3 py-1.5 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-teal-500"
        />
      </div>
    </div>

    <!-- Tag Cloud Strip -->
    <div class="flex flex-wrap items-center gap-1.5 py-2 font-mono text-xs text-zinc-500">
      <span class="mr-1 text-zinc-400">Popular tags:</span>
      {tags.map(([tag, count]) => (
        <a
          href={url(`/tags/${tag}`)}
          class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 hover:border-zinc-400 dark:hover:border-zinc-600 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        >
          #{tag} <span class="text-zinc-400 text-[10px]">({count})</span>
        </a>
      ))}
    </div>

    <!-- Posts Grid / List -->
    <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-4">
      {sortedPosts.map((post) => (
        <div class="post-item" data-type={post.data.type} data-title={post.data.title.toLowerCase()}>
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-posts-message" class="hidden text-center py-16">
      <p class="font-mono text-sm text-zinc-500">No posts match your selected filter.</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupBlogFilters() {
    const params = new URLSearchParams(window.location.search);
    const initialType = params.get('type') || 'all';

    const tabs = document.querySelectorAll('.filter-tab');
    const posts = document.querySelectorAll('.post-item');
    const input = document.getElementById('post-quick-filter');
    const emptyMsg = document.getElementById('no-posts-message');

    function applyFilter(selectedType, searchQuery = '') {
      let visibleCount = 0;
      tabs.forEach((tab) => {
        const type = tab.getAttribute('data-type');
        if (type === selectedType) {
          tab.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-zinc-100', 'shadow-xs', 'font-medium');
          tab.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        } else {
          tab.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-zinc-100', 'shadow-xs', 'font-medium');
          tab.classList.add('text-zinc-600', 'dark:text-zinc-400');
        }
      });

      posts.forEach((item) => {
        const itemType = item.getAttribute('data-type');
        const itemTitle = item.getAttribute('data-title') || '';
        const matchesType = selectedType === 'all' || itemType === selectedType;
        const matchesSearch = !searchQuery || itemTitle.includes(searchQuery.toLowerCase());

        if (matchesType && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }
      }
    }

    // Intercept tab clicks for fast client-side tab switching without reloading
    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const type = tab.getAttribute('data-type') || 'all';
        const newUrl = type === 'all' ? window.location.pathname : `?type=${type}`;
        window.history.replaceState({}, '', newUrl);
        applyFilter(type, input ? input.value : '');
      });
    });

    if (input) {
      input.addEventListener('input', () => {
        const currentType = new URLSearchParams(window.location.search).get('type') || 'all';
        applyFilter(currentType, input.value);
      });
    }

    // Initial run
    applyFilter(initialType);
  }

  setupBlogFilters();
  document.addEventListener('astro:after-swap', setupBlogFilters);
</script>
