---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort: featured first, then by year descending
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return Number(b.data.year) - Number(a.data.year);
});

const totalCount = sortedProjects.length;
const shippedCount = sortedProjects.filter((p) => p.data.status === 'shipped').length;
const inProgressCount = sortedProjects.filter((p) => p.data.status === 'in-progress').length;
---

<BaseLayout
  title="Projects Directory"
  description="Full Wikipedia-style catalog of web applications, systems, academic course projects, and hackathon prototypes."
>
  <div class="space-y-6">
    <!-- Header -->
    <header class="pb-2 border-b border-[var(--border-color)]">
      <h1 class="font-serif text-3xl sm:text-4xl text-[var(--text-primary)] font-normal">
        List of Software Projects
      </h1>
      <p class="text-xs font-serif italic text-[var(--text-secondary)] mt-1">
        Catalog of software systems, course projects, and prototypes developed by Ali Hasan.
      </p>
    </header>

    <!-- Wikipedia Filter Bar -->
    <div class="border border-[var(--border-color)] bg-[var(--bg-surface)] p-2.5 flex items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-1">
        <span class="text-[var(--text-muted)] mr-2">Filter status:</span>
        <button
          type="button"
          data-filter="all"
          class="proj-filter px-2.5 py-1 border border-[var(--border-color)] bg-[var(--bg-primary)] font-bold text-[var(--text-primary)]"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          data-filter="shipped"
          class="proj-filter px-2.5 py-1 border border-transparent text-[var(--text-secondary)] hover:border-[var(--border-subtle)]"
        >
          Shipped ({shippedCount})
        </button>
        <button
          type="button"
          data-filter="in-progress"
          class="proj-filter px-2.5 py-1 border border-transparent text-[var(--text-secondary)] hover:border-[var(--border-subtle)]"
        >
          In Progress ({inProgressCount})
        </button>
      </div>

      <div class="text-[11px] text-[var(--text-muted)] hidden sm:block">
        Format: Encyclopedia List
      </div>
    </div>

    <!-- Projects Grid / Cards -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedProjects.map((project) => {
        const { title, summary, stack, status, repo, liveUrl, year, featured } = project.data;
        return (
          <div
            class="project-card border border-[var(--border-color)] bg-[var(--bg-card)] p-4 flex flex-col justify-between"
            data-status={status}
          >
            <div>
              <!-- Meta Header -->
              <div class="flex items-center justify-between gap-2 pb-2 mb-2 border-b border-[var(--border-light)] text-[11px] font-mono">
                <div class="flex items-center gap-1.5">
                  <Badge type={status} />
                  {featured && (
                    <span class="border border-[var(--border-color)] px-1 font-bold text-[9px] uppercase">
                      ★ Featured
                    </span>
                  )}
                </div>
                <span class="text-[var(--text-muted)]">{year}</span>
              </div>

              <!-- Title -->
              <h2 class="font-serif text-base font-bold text-[var(--text-primary)] mb-2 leading-snug">
                {title}
              </h2>

              <!-- Summary -->
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-3">
                {summary}
              </p>
            </div>

            <div>
              <!-- Tech stack list -->
              <div class="flex flex-wrap gap-1 mb-3 font-mono text-[10px] text-[var(--text-muted)]">
                {stack.map((t) => (
                  <span class="border border-[var(--border-subtle)] px-1 bg-[var(--bg-surface)]">
                    {t}
                  </span>
                ))}
              </div>

              <!-- Links -->
              <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center gap-3 text-xs font-mono">
                {repo && (
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
                  >
                    Source &nearr;
                  </a>
                )}
                {liveUrl && (
                  <a
                    href={liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline font-bold hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
                  >
                    Live Demo &nearr;
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupProjectFilters() {
    const filterButtons = document.querySelectorAll('.proj-filter');
    const cards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterButtons.forEach((b) => {
          if (b === btn) {
            b.classList.add('bg-[var(--bg-primary)]', 'font-bold', 'text-[var(--text-primary)]', 'border-[var(--border-color)]');
            b.classList.remove('border-transparent', 'text-[var(--text-secondary)]');
          } else {
            b.classList.remove('bg-[var(--bg-primary)]', 'font-bold', 'text-[var(--text-primary)]', 'border-[var(--border-color)]');
            b.classList.add('border-transparent', 'text-[var(--text-secondary)]');
          }
        });

        cards.forEach((card) => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
