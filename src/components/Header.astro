---
import siteConfig from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils/paths';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Main Page', href: url('/') },
  { label: 'Blog Archive', href: url('/blog') },
  { label: 'Projects', href: url('/projects') },
  { label: 'About Ali', href: url('/about') },
  { label: 'Now', href: url('/now') },
];

function isActive(href: string) {
  if (href === url('/')) return pathname === href;
  return pathname.startsWith(href);
}
---

<header class="w-full bg-[var(--bg-primary)] border-b border-[var(--border-color)]">
  <!-- Top Wikipedia Utility Bar -->
  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[11px] font-mono text-[var(--text-secondary)]">
    <div class="max-w-5xl mx-auto px-4 py-1 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span>EN</span>
        <span class="text-[var(--border-color)]">|</span>
        <span>Karachi, PK</span>
        <span class="hidden sm:inline text-[var(--border-color)]">|</span>
        <span class="hidden sm:inline">BCIT @ NED University</span>
      </div>
      <div class="flex items-center gap-3">
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
          GitHub: {siteConfig.githubUser} &nearr;
        </a>
        <span class="text-[var(--border-color)]">|</span>
        <ThemeToggle />
      </div>
    </div>
  </div>

  <!-- Main Wiki Masthead -->
  <div class="max-w-5xl mx-auto px-4 py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <!-- Wikipedia Brand Icon & Title -->
    <div class="flex items-center gap-3">
      <a
        href={url('/')}
        class="flex items-center gap-3 text-[var(--text-primary)] hover:opacity-85 transition-opacity group"
      >
        <!-- Wikipedia 'W' Glyph Emblem -->
        <div class="w-9 h-9 border border-[var(--border-color)] bg-[var(--bg-surface)] flex items-center justify-center font-serif font-black text-xl select-none group-hover:bg-[var(--text-primary)] group-hover:text-[var(--bg-primary)] transition-colors">
          W
        </div>
        <div>
          <div class="font-serif text-xl sm:text-2xl font-bold tracking-tight leading-none">
            {siteConfig.name}
          </div>
          <div class="text-[11px] text-[var(--text-secondary)] font-serif italic mt-0.5">
            The free personal encyclopedia of dev rants and software builds
          </div>
        </div>
      </a>
    </div>

    <!-- Wikipedia Search Bar & Mobile Toggle -->
    <div class="flex items-center gap-2 w-full md:w-auto">
      <button
        id="search-open-btn"
        type="button"
        class="w-full md:w-64 flex items-center justify-between px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--bg-primary)] text-xs text-[var(--text-secondary)] transition-colors text-left"
        aria-label="Search this wiki"
      >
        <span class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search {siteConfig.name}...</span>
        </span>
        <kbd class="px-1 text-[10px] font-mono border border-[var(--border-subtle)] bg-[var(--bg-primary)] text-[var(--text-muted)]">⌘K</kbd>
      </button>

      <!-- Mobile Nav Hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden px-2.5 py-1.5 border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono"
        aria-label="Toggle navigation"
      >
        ☰ Tabs
      </button>
    </div>
  </div>

  <!-- Wikipedia Tabbed Navigation Bar -->
  <div class="max-w-5xl mx-auto px-4 border-t border-[var(--border-subtle)] pt-1">
    <nav class="hidden md:flex items-center gap-1 text-xs">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 border-t border-x transition-colors ${
              active
                ? 'border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-primary)] font-semibold -mb-[1px] pb-2'
                : 'border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-subtle)] bg-[var(--bg-surface)]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--border-color)] bg-[var(--bg-surface)] px-4 py-2 space-y-1 text-xs font-mono">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`block px-2 py-1.5 border border-transparent ${
            active
              ? 'border-[var(--border-color)] bg-[var(--bg-primary)] font-bold'
              : 'hover:bg-[var(--bg-primary)]'
          }`}
        >
          &gt; {item.label}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
