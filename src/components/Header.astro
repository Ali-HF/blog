---
import siteConfig from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils/paths';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Blog', href: url('/blog') },
  { label: 'Projects', href: url('/projects') },
  { label: 'About', href: url('/about') },
  { label: 'Now', href: url('/now') },
];

function isActive(href: string) {
  if (href === url('/')) return pathname === href;
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200 dark:border-zinc-800 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo / Brand -->
    <a
      href={url('/')}
      class="group flex items-center gap-2 text-zinc-900 dark:text-zinc-100 font-mono font-bold tracking-tight text-lg hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
    >
      <span class="text-zinc-400 dark:text-zinc-600 group-hover:text-teal-500 transition-colors">&gt;</span>
      <span>{siteConfig.name}</span>
      <span class="inline-block w-2 h-4 bg-teal-500 animate-pulse ml-0.5"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-sm">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md transition-colors ${
              active
                ? 'text-zinc-950 dark:text-white font-semibold bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700'
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Actions (Search, Theme Toggle, GitHub) -->
    <div class="flex items-center gap-2">
      <!-- Search button -->
      <button
        id="search-open-btn"
        type="button"
        class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-850 font-mono text-xs transition-colors"
        aria-label="Search posts"
        title="Search (Ctrl+K)"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline px-1 py-0.5 text-[10px] bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded text-zinc-500">⌘K</kbd>
      </button>

      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- GitHub Profile Icon Link -->
      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
        aria-label="Ali-HF GitHub Profile"
        title="GitHub Profile"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-md border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        aria-label="Open mobile menu"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-3 space-y-1 font-mono text-sm">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded-md transition-colors ${
            active
              ? 'text-teal-600 dark:text-teal-400 font-semibold bg-zinc-100 dark:bg-zinc-900'
              : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-900'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
