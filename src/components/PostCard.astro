---
import Badge from './Badge.astro';
import { url } from '../utils/paths';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      type: 'rant' | 'build';
      tags: string[];
      status?: 'shipped' | 'in-progress' | 'abandoned';
      stack?: string[];
      readingTime?: string;
    };
  };
}

const { post } = Astro.props;
const { title, description, pubDate, type, tags, status, stack } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);

const postUrl = url(`/blog/${post.id}`);
---

<article
  class="group relative flex flex-col p-4 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--text-primary)] transition-colors"
>
  <!-- Wiki Header: Type Badge, Date -->
  <div class="flex items-center justify-between gap-2 pb-2 mb-2 border-b border-[var(--border-light)] text-[11px] font-mono text-[var(--text-secondary)]">
    <div class="flex items-center gap-1.5">
      <Badge type={type} />
      {status && <Badge type={status} />}
    </div>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>

  <!-- Serif Title (Wikipedia style) -->
  <h2 class="font-serif text-lg font-bold text-[var(--text-primary)] group-hover:underline leading-snug mb-2">
    <a href={postUrl} class="focus:outline-none">
      <span class="absolute inset-0 z-0"></span>
      {title}
    </a>
  </h2>

  <!-- Description -->
  <p class="text-xs text-[var(--text-secondary)] leading-relaxed flex-1 mb-3">
    {description}
  </p>

  <!-- Stack items -->
  {stack && stack.length > 0 && (
    <div class="relative z-10 flex flex-wrap gap-1 mb-2 font-mono text-[10px] text-[var(--text-muted)]">
      <span class="font-bold text-[var(--text-secondary)]">Stack:</span>
      {stack.slice(0, 4).map((tech) => (
        <span class="border border-[var(--border-subtle)] px-1 bg-[var(--bg-surface)]">
          {tech}
        </span>
      ))}
      {stack.length > 4 && (
        <span>+{stack.length - 4}</span>
      )}
    </div>
  )}

  <!-- Wiki Categories (Tags) -->
  {tags && tags.length > 0 && (
    <div class="relative z-10 flex flex-wrap items-center gap-1 pt-2 border-t border-[var(--border-subtle)] text-[11px] font-mono text-[var(--text-muted)]">
      <span class="text-[var(--text-secondary)]">Categories:</span>
      {tags.map((tag) => (
        <a
          href={url(`/tags/${tag}`)}
          class="hover:underline text-[var(--text-primary)]"
        >
          [[{tag}]]
        </a>
      ))}
    </div>
  )}
</article>
