---
import siteConfig from '../site.config';
import { url } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] mt-auto pt-6 pb-8 text-xs font-serif">
  <div class="max-w-5xl mx-auto px-4 space-y-3">
    <!-- Wikipedia CC Notice -->
    <div class="text-[11px] leading-relaxed text-[var(--text-secondary)]">
      Text is available under the <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="underline">Creative Commons Attribution-ShareAlike License 4.0</a>; additional terms may apply. By using this site, you agree to read unfiltered developer rants and verify code architectures before running them in production.
    </div>

    <!-- Wiki Footer Navigation Links -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs pt-1 border-t border-[var(--border-subtle)]">
      <a href={url('/about')} class="underline hover:text-[var(--text-primary)]">About {siteConfig.name}</a>
      <span>•</span>
      <a href={url('/projects')} class="underline hover:text-[var(--text-primary)]">Projects Catalog</a>
      <span>•</span>
      <a href={url('/rss.xml')} class="underline hover:text-[var(--text-primary)]">RSS Feed</a>
      <span>•</span>
      <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--text-primary)]">GitHub ({siteConfig.githubUser})</a>
      <span>•</span>
      <span>Curated in Karachi, Pakistan © {currentYear}</span>
    </div>

    <div class="text-[10px] font-mono text-[var(--text-muted)] pt-1 flex items-center justify-between">
      <span>Built with Astro (Static HTML &amp; Pagefind)</span>
      <span>No cookies • Zero trackers</span>
    </div>
  </div>
</footer>
