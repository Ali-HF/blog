---
import { url } from '../utils/paths';
---

<div
  id="search-dialog-backdrop"
  class="fixed inset-0 z-50 bg-black/50 hidden items-start justify-center pt-16 sm:pt-20 px-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-input"
>
  <div class="relative w-full max-w-xl bg-[var(--bg-primary)] border border-[var(--border-color)] shadow-lg overflow-hidden">
    <!-- Header with Input -->
    <div class="flex items-center gap-3 px-3 py-2.5 border-b border-[var(--border-color)] bg-[var(--bg-surface)]">
      <svg class="w-4 h-4 text-[var(--text-muted)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search encyclopedia articles, rants, builds..."
        class="w-full bg-transparent text-xs font-mono text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none"
        autocomplete="off"
      />
      <button
        id="search-close-btn"
        type="button"
        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs font-mono"
        aria-label="Close search"
      >
        <kbd class="px-1.5 py-0.5 bg-[var(--bg-primary)] border border-[var(--border-color)]">[ESC]</kbd>
      </button>
    </div>

    <!-- Search Output / Pagefind results container -->
    <div id="search-results" class="max-h-96 overflow-y-auto p-3 text-xs divide-y divide-[var(--border-light)] font-serif">
      <p class="text-xs text-[var(--text-muted)] font-mono text-center py-6">
        Type to search the wiki encyclopedia...
      </p>
    </div>

    <!-- Footer hint -->
    <div class="px-3 py-2 bg-[var(--bg-surface)] border-t border-[var(--border-color)] flex items-center justify-between text-[10px] font-mono text-[var(--text-muted)]">
      <span>Index: Pagefind Client-side</span>
      <span>Press <kbd class="px-1 py-0.2 border border-[var(--border-subtle)] bg-[var(--bg-primary)]">ESC</kbd> to dismiss</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ baseSearchUrl: url('/pagefind/pagefind.js'), blogUrl: url('/blog') }}>
  let pagefindInstance = null;
  let isPagefindLoaded = false;

  async function loadPagefind() {
    if (isPagefindLoaded) return pagefindInstance;
    try {
      const pagefind = await import(/* @vite-ignore */ baseSearchUrl);
      await pagefind.init();
      pagefindInstance = pagefind;
      isPagefindLoaded = true;
      return pagefindInstance;
    } catch (e) {
      console.info('Pagefind index not found, falling back to page indexer.');
      return null;
    }
  }

  function setupSearch() {
    const backdrop = document.getElementById('search-dialog-backdrop');
    const openBtn = document.getElementById('search-open-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');

    if (!backdrop || !input) return;

    function openSearch() {
      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');
      input.value = '';
      input.focus();
      loadPagefind();
    }

    function closeSearch() {
      backdrop.classList.add('hidden');
      backdrop.classList.remove('flex');
    }

    if (openBtn) openBtn.addEventListener('click', openSearch);
    if (closeBtn) closeBtn.addEventListener('click', closeSearch);

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeSearch();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeSearch();
      }
    });

    let debounceTimer;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const query = input.value.trim();
        if (!query) {
          resultsContainer.innerHTML = '<p class="text-xs text-[var(--text-muted)] font-mono text-center py-6">Type to search the wiki encyclopedia...</p>';
          return;
        }

        const pf = await loadPagefind();
        if (pf) {
          const search = await pf.search(query);
          if (search.results.length === 0) {
            resultsContainer.innerHTML = `<p class="text-xs text-[var(--text-muted)] font-mono text-center py-6">No matching encyclopedia entries found for "${query}"</p>`;
            return;
          }

          const loadedResults = await Promise.all(search.results.slice(0, 8).map(r => r.data()));
          resultsContainer.innerHTML = loadedResults.map(res => `
            <a href="${res.url}" class="block py-2 px-2 hover:bg-[var(--bg-surface)] transition-colors group">
              <div class="font-serif font-bold text-sm text-[var(--text-primary)] group-hover:underline">
                ${res.meta.title || 'Untitled'}
              </div>
              <p class="text-xs text-[var(--text-secondary)] line-clamp-2 mt-0.5">
                ${res.excerpt || ''}
              </p>
            </a>
          `).join('');
        } else {
          resultsContainer.innerHTML = `
            <div class="text-center py-6 space-y-2 font-mono">
              <p class="text-xs text-[var(--text-muted)]">Pagefind search indexes are generated upon build.</p>
              <a href="${blogUrl}" class="text-xs underline">Browse complete article directory &rarr;</a>
            </div>
          `;
        }
      }, 150);
    });
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
