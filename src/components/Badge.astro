---
interface Props {
  type?: 'rant' | 'build' | 'shipped' | 'in-progress' | 'abandoned' | 'tag' | 'neutral';
  text?: string;
  size?: 'sm' | 'md';
}

const { type = 'neutral', text, size = 'sm' } = Astro.props;

// Pure black and white Wikipedia styling
const styles: Record<string, string> = {
  rant: 'border-black dark:border-white bg-black dark:bg-white text-white dark:text-black font-bold',
  build: 'border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)] font-semibold',
  shipped: 'border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)]',
  'in-progress': 'border-[var(--border-color)] border-dashed bg-transparent text-[var(--text-secondary)]',
  abandoned: 'border-[var(--border-subtle)] text-[var(--text-muted)] line-through',
  tag: 'border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)]',
  neutral: 'border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)]',
};

const sizeStyles = {
  sm: 'text-[10px] px-1.5 py-0.2',
  md: 'text-xs px-2 py-0.5',
};

const label = text || type;
---

<span
  class={`inline-flex items-center gap-1 font-mono uppercase tracking-wider border rounded-none transition-colors ${styles[type] || styles.neutral} ${sizeStyles[size]}`}
>
  {type === 'rant' && <span class="text-[9px]">■</span>}
  {type === 'build' && <span class="text-[9px]">□</span>}
  {type === 'shipped' && <span class="text-[9px]">✓</span>}
  {type === 'in-progress' && <span class="text-[9px]">⧗</span>}
  <slot>{label}</slot>
</span>
